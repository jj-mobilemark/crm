
datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // CRM ownership. Better Auth owns every field above and `bun run
  // auth:generate` rewrites them; these back-relations are ours and have to be
  // put back if that ever wipes them.
  /// Opt-in morning email of open tasks (America/Chicago 9:00). Default off.
  dailyTaskPush          Boolean   @default(false)
  /// Chicago calendar date `YYYY-MM-DD` of the last successful daily push.
  dailyTaskPushLastSentOn String?
  ownedCompanies Company[]     @relation("CompanyOwner")
  ownedContacts  Contact[]     @relation("ContactOwner")
  ownedDeals     Deal[]        @relation("DealOwner")
  activities     Activity[]    @relation("ActivityAuthor")
  mailboxSyncs   MailboxSync[]
  factDecisions  ContactFact[] @relation("FactDecider")
  conversations  AgentConversation[] @relation("ConversationOwner")
  followUpPreference FollowUpPreference?
  createdSequences     EmailSequence[]      @relation("SequenceCreator")
  sequenceEnrollments  SequenceEnrollment[] @relation("SequenceSender")
  enrolledSequences    SequenceEnrollment[] @relation("SequenceEnroller")
  dealFieldChanges     DealFieldChange[]    @relation("DealFieldChangeActor")
  pendingContacts      PendingContact[]     @relation("PendingContactRep")
  pendingWebLeadsAssigned PendingWebLead[]  @relation("PendingWebLeadAssignee")
  pendingWebLeadsClaimed  PendingWebLead[]  @relation("PendingWebLeadClaimer")
  tripPlans            TripPlan[]           @relation("TripPlanOwner")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// CRM
//
// Companies are the top-level object; contacts and deals hang off them, and
// everything that happens is an Activity on a timeline.
// ---------------------------------------------------------------------------

enum DealStage {
  DEMO_BOOKED
  QUALIFIED_TO_BUY
  /// Terminal, not a step forward — disqualified, and excluded from pipeline value.
  UNQUALIFIED_TO_BUY
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  /// Sage Purchasing / In Purchasing (90% certainty). Kept as its own open stage.
  IN_PURCHASING
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  /// Written by the system when Deal.stage changes.
  STAGE_CHANGE
  /// Written by the enrichment agent.
  ENRICHMENT
}

/// Rep-facing priority for deals and tasks. Null means "no priority set".
/// Declaration order is sort order in Postgres (LOW < … < HIGHEST).
enum Priority {
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  /// The lookup failed and is worth retrying — see Company.enrichmentError.
  FAILED
  /// There is nothing to find (unknown domain, free email host). Not an error.
  SKIPPED
}

/// Where a record came from. Auto-created rows are tagged so a bad matching
/// rule is visible and reversible in bulk, rather than silently indistinguishable
/// from something a rep typed.
enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  /// Pulled from Sage CRM (see `docs/plans/sage-crm-sync.md`).
  SAGE
}

model Company {
  id          String  @id @default(cuid())
  name        String
  /// Bare and normalised ("stripe.com"). Unique because two records for one
  /// domain is the fastest way to rot a CRM, and it is the enrichment key.
  domain      String? @unique
  website     String?
  description String?

  // Brand, from Context.dev.
  logoUrl     String?
  logoDarkUrl String?
  /// Square mark, used in table rows.
  iconUrl     String?
  /// The dark-mode square mark, when the brand publishes one. Rare — most
  /// brands ship a light-mode logo only, which is what `iconTone` is for.
  iconDarkUrl String?
  /// How `iconUrl` behaves against a background, from Context.dev's `mode` plus
  /// the artwork's own dominant colour:
  ///
  /// - `opaque`  — the icon is composed on its own background; never put a
  ///               surface behind it.
  /// - `dark`    — dark artwork on transparency; invisible in dark mode without
  ///               a light surface behind it.
  /// - `light`   — light artwork on transparency; the same problem in reverse.
  iconTone    String?
  /// Hex. An accent only — brand colours would fight the design tokens.
  brandColor  String?

  // Firmographics.
  industry    String?
  subIndustry String?
  /// Street line from Sage nested address (`address1`). Display only —
  /// geocode stays city-level (`city` / `stateCode` / `countryCode`).
  streetAddress String?
  city          String?
  stateCode     String?
  postalCode    String?
  country       String?
  countryCode   String?

  /// City-level map pin from Nominatim (or GeocodeCache). Cleared when the
  /// city/state/country fields change so the next geocode pass can re-resolve.
  latitude         Float?
  longitude        Float?
  /// Normalised `city|stateCode|countryCode` used to look up GeocodeCache.
  geocodePlaceKey  String?
  geocodedAt       DateTime?

  // Contact details and socials.
  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  /// MANUAL unless a sync created it. Filterable, so a bad auto-create rule can
  /// be undone in bulk.
  source RecordSource @default(MANUAL)

  /// Sage CRM entity id (eware `companyid`, e.g. "4139"). The join key for the
  /// Sage pull; unique so a re-pull updates rather than duplicates.
  sageCrmCompanyId String? @unique
  /// Sage 100 customer key, split as Sage stores it: AR division + customer
  /// number (e.g. "00" + "0000777"). Shown to reps as "<div>-<no>" and the join
  /// to MasHeader / MasOrderDetailHistory for a later order-history phase.
  sage100CustomerNo   String?
  sage100ArDivisionNo String?

  /// Set when a Sage reconcile no longer sees this company (deleted/merged in
  /// Sage). We never hard-delete a Sage-sourced row — soft-deactivate instead.
  sageDeactivatedAt DateTime?
  /// Push echo-guard (design only for now). `sagePushedAt` is when we last
  /// pushed a local edit to Sage; `sageUpdatedAt` is the Sage `updateddate` we
  /// last pulled. On a pull, a Sage change at/before `sagePushedAt` is our own
  /// write coming back and is skipped.
  sagePushedAt  DateTime?
  sageUpdatedAt DateTime?

  /// Denormalised max(activity.createdAt), written with the activity.
  ///
  /// A real column because it is a sortable column on every list, and ordering
  /// by an aggregate over a relation is something Prisma cannot express — the
  /// alternative is a correlated subquery per row, which would be the slowest
  /// thing on the page. Maintained through `ActivityStampService`.
  lastActivityAt DateTime?

  contacts       Contact[]       @relation("CompanyContacts")
  conversations  AgentConversation[]
  deals          Deal[]
  activities     Activity[]
  emailThreads   EmailThread[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@index([geocodePlaceKey])
  @@map("company")
}

/// Cached Nominatim (or other) result for a normalised place key. One row per
/// unique city/state/country so ~14k companies share a few thousand lookups.
model GeocodeCache {
  placeKey  String               @id
  latitude  Float?
  longitude Float?
  status    GeocodeCacheStatus
  /// Display label Nominatim returned, when status is ok.
  rawLabel  String?
  queriedAt DateTime             @default(now())

  @@map("geocodeCache")
}

enum GeocodeCacheStatus {
  ok
  failed
  skipped
}

/// The raw Context.dev payload, kept so re-deriving a field costs nothing and
/// no credits.
model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String?
  /// Unique, matching HubSpot, so a CSV import can be re-run safely. The cost:
  /// two people behind one info@ address need one email between them.
  email       String?  @unique
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  /// The contact's photo, mirrored into Vercel Blob.
  ///
  /// Never LinkedIn's own CDN URL: those carry an `e=` expiry parameter and go
  /// dead within weeks, so a hotlinked avatar silently becomes a broken image.
  imageUrl    String?

  /// When the agent last went looking for this person's X and GitHub accounts.
  ///
  /// Stamped whether or not it found any, which is the point: most people have
  /// neither, and without it the hourly run would search the same fruitless
  /// contacts forever. Null means never looked; a date with both URLs still
  /// null means looked and found nothing it could stand behind.
  socialsCheckedAt DateTime?

  /// Mirrors `Company`, so the sheet reuses `isEnriching()` and the existing
  /// poll rather than inventing a second freshness mechanism.
  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  /// Who this person is (§3 of the contact-intelligence plan) and every claim
  /// behind the fields above.
  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId   String?
  company     Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf   Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  /// Sage CRM entity id (eware `personid`, e.g. "5"). Unique so a re-pull
  /// updates rather than duplicates. A contact has no Sage 100 id of its own —
  /// its Sage 100 customer key is the parent company's, shown via the relation.
  sageCrmContactId String? @unique

  /// Soft-deactivate + push echo-guard — see the matching fields on `Company`.
  sageDeactivatedAt DateTime?
  sagePushedAt      DateTime?
  sageUpdatedAt     DateTime?

  /// Denormalised max(activity.createdAt), written with the activity.
  ///
  /// A real column because it is a sortable column on every list, and ordering
  /// by an aggregate over a relation is something Prisma cannot express — the
  /// alternative is a correlated subquery per row, which would be the slowest
  /// thing on the page. Maintained through `ActivityStampService`.
  lastActivityAt DateTime?

  deals           DealContact[]
  activities      Activity[]
  emailThreads    EmailThread[]
  calendarEvents  CalendarEvent[]
  eventAttendance CalendarAttendee[]
  sequenceEnrollments SequenceEnrollment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@map("contact")
}

/// How much of a claim we believe, and what that licenses.
///
/// The bands are the behaviour, not a label: `VERIFIED` is written to the
/// record, `PROBABLE` is offered to a human, `POSSIBLE` is kept but never shown
/// as a value. The numeric `score` beside them exists so the thresholds can be
/// re-calibrated against evals without re-running the research.
enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

/// One claim about one field of one contact, with everything behind it.
///
/// The point of a separate table: `Contact.title` can only hold the answer,
/// and the answer is the least interesting part. This holds where it came
/// from, how sure we are, what else was considered, and what it replaced —
/// which is what makes an enriched field auditable rather than merely present.
///
/// It is deliberately *not* the read path. Current values stay denormalised on
/// `Contact` so a list is one query; this is the reasoning behind them.
model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// The `Contact` column this is about — "title", "linkedinUrl", "employer".
  field String
  value String

  score Float
  band  FactBand

  /// The full ledger: `[{ kind, weight, detail, sourceUrl }]`. Kept so the
  /// score can be explained to a rep and recomputed after a re-calibration.
  evidence Json

  method    String
  sourceUrl String?

  /// The eve session that produced it, joining to `AgentEvent` for "show your
  /// work".
  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

/// The background panel on a contact: who they are, in prose and in fields.
model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Two or three sentences. Present tense, their name first.
  narrative String
  /// `{ currentRole, tenure, previousRoles[], seniority, function, location }`
  /// — shaped by the agent, rendered by the sheet, so adding a line does not
  /// need a migration.
  sections Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

/// What the agent has decided to do, and why.
///
/// The work queue *and* the audit trail. A cron expression can only say "every
/// hour for everybody"; a row here says "this person, in fourteen days,
/// because a job change would move a live deal" — and the reason is shown to
/// the rep rather than buried in a prompt.
model AgentTask {
  id        String  @id @default(cuid())
  contactId String?
  companyId String?
  /// Set for a per-rep task (kind `"followups"`) rather than a per-record one.
  userId    String?

  kind   String
  reason String

  priority Int @default(0)
  /// Research units this task may spend. Depth is a decision, and this is
  /// what the agent decides it against.
  budget Int @default(4)
  /// How many times this row has been handed to a session.
  ///
  /// The lease is a deadline rather than a flag so a crashed run frees its
  /// row — but a deadline alone cannot tell "died, retry me" from "cannot
  /// ever finish". Without a count the second case is re-leased every ten
  /// minutes forever, resuming the same durable session and paying for a
  /// model turn each time. Two rows did exactly that for an hour and a half.
  attempts Int @default(0)

  dueAt DateTime
  /// Held by a dispatcher tick. An expired lease is free to reclaim, which is
  /// what makes a crashed run recoverable rather than stuck.
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([userId])
  @@map("agentTask")
}

/// Every runtime event the agent emits, written by a hook.
///
/// The id is eve's own `meta.id` (a ULID), so an `on conflict do nothing`
/// insert is replay-safe: reconnecting to a stream, rewinding it, or restoring
/// a saved log cannot duplicate a row. Leading with a timestamp also keeps the
/// primary key roughly append-ordered.
///
/// This is what "show your work" reads. Without it the agent's reasoning lives
/// only in a log nobody can query and nobody can show a rep.
model AgentEvent {
  id        String @id
  sessionId String
  contactId String?
  type      String
  data      Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@map("agentEvent")
}

/// A conversation between a rep and the agent, about one record.
///
/// The transcript itself is already in `AgentEvent` — this is the *handle*: the
/// durable eve session to resume, and enough metadata to list a record's
/// history without reading a single event. Reopening a contact should show what
/// you asked last week rather than an empty box.
///
/// `sessionId` is unique because one eve session is one conversation. The
/// cursor beside it (`continuationToken`, `streamIndex`) is what `useEveAgent`
/// needs to pick the thread back up instead of starting a new one.
model AgentConversation {
  id String @id @default(cuid())

  /// Which record it is about. Exactly one of contact/company/deal is set —
  /// unless this is a pipeline (overview) or trip-planner session, which set
  /// `pipelineScope` / `tripPlanId` instead and leave the three FKs null.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Overview pipeline chat: `"me"` or `"everyone"`. Mutually exclusive with
  /// the three record FKs and `tripPlanId` above.
  pipelineScope String?

  /// Trip Planner chat — filed under the saved trip, not a CRM record.
  tripPlanId String?
  tripPlan   TripPlan? @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)

  /// Whose conversation. Two reps asking about the same contact are having two
  /// different conversations, and neither should see the other's half-finished
  /// question.
  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  sessionId         String  @unique
  continuationToken String?
  /// How far the client had read, so a reopened thread does not replay.
  streamIndex Int @default(0)

  /// The first thing the rep asked, trimmed. Written once.
  title        String?
  messageCount Int     @default(0)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([userId, pipelineScope, lastMessageAt])
  @@index([userId, tripPlanId, lastMessageAt])
  @@map("agentConversation")
}

/// Saved sales-trip brief for Trip Planner. The agent reads this via
/// `tripPlanId` (JWT claim) and writes a structured itinerary JSON.
enum TripActivityMode {
  /// Companies with a deal created or closed within `activityYears`.
  ACTIVE
  /// Companies with no deal created or closed within `activityYears`.
  SALVAGE
}

enum TripPlanStatus {
  DRAFT
  PLANNED
}

model TripPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TripPlanOwner", fields: [userId], references: [id], onDelete: Cascade)

  hubCity            String
  hubStateCode       String
  hubLatitude        Float
  hubLongitude       Float
  hubGeocodePlaceKey String?

  dayCount       Int              @default(3)
  radiusMiles    Int              @default(200)
  activityMode   TripActivityMode @default(ACTIVE)
  activityYears  Int              @default(3)
  /// Company ids the rep already plans to visit (may be outside the radius).
  mustVisitCompanyIds String[]    @default([])
  maxVisitsPerDay Int?
  notes           String?

  /// Structured day→stops plan written by `write_trip_itinerary`.
  itinerary Json?
  status    TripPlanStatus @default(DRAFT)

  conversations AgentConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("tripPlan")
}

model Deal {
  id            String              @id @default(cuid())
  conversations AgentConversation[]
  name          String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Required: every deal has a name against it.
  ownerId   String
  owner     User    @relation("DealOwner", fields: [ownerId], references: [id])

  stage             DealStage @default(DEMO_BOOKED)
  stageChangedAt    DateTime  @default(now())
  /// Optional urgency. Null = no priority set.
  priority          Priority?
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?

  /// Sage CRM opportunity id (eware `opportunityid`). Join key for the Sage
  /// pull; unique so a re-pull updates rather than duplicates. Opportunities
  /// are Sage CRM only — no Sage 100 id.
  sageCrmOpportunityId String? @unique
  /// Sage certainty % (0–100). Forecasting lives on the opportunity in Sage.
  probability Int?
  /// Sage `forecast` — weighted revenue. Paired with `amount` <- `total`.
  weightedAmount Decimal? @db.Decimal(14, 2)
  /// Sage opportunity `type` (e.g. Key Opportunity / New Business).
  dealType String?
  /// Raw Sage stage/status for 1:1 push and board display without a snapshot read.
  sageStage  String?
  sageStatus String?

  /// Soft-deactivate + push echo-guard — see the matching fields on `Company`.
  sageDeactivatedAt DateTime?
  sagePushedAt      DateTime?
  sageUpdatedAt     DateTime?

  /// Denormalised max(activity.createdAt), written with the activity.
  ///
  /// A real column because it is a sortable column on every list, and ordering
  /// by an aggregate over a relation is something Prisma cannot express — the
  /// alternative is a correlated subquery per row, which would be the slowest
  /// thing on the page. Maintained through `ActivityStampService`.
  lastActivityAt DateTime?

  contacts     DealContact[]
  activities   Activity[]
  fieldChanges DealFieldChange[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([priority])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@map("deal")
}

/// Append-only log of deal field moves for the overview pulse.
///
/// Written when the app edits a deal or Sage pull applies a non-echo update.
/// `SageRecordSnapshot` is latest-only; this table is what makes "certainty
/// went 50 → 75" queryable. Values are stringified so one table covers stage
/// enums, ints, money, and dates without a JSON blob per row.
model DealFieldChange {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// stage | probability | amount | expectedCloseDate | ownerId | priority | sageStage
  field     String
  fromValue String?
  toValue   String?
  /// "app" (UI / Nest write) | "sage" (pull applied a remote change).
  source String

  /// Set for app writes; null for Sage-originated rows.
  actorUserId String?
  actor       User?   @relation("DealFieldChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([dealId, createdAt])
  @@index([field, createdAt])
  @@index([source, createdAt])
  @@map("dealFieldChange")
}

model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String?

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("dealContact")
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String?
  body    String?

  /// Set when the thing already happened.
  occurredAt  DateTime?
  /// Set when it is scheduled. Overdue is dueAt in the past with no completedAt.
  dueAt       DateTime?
  completedAt DateTime?
  /// Optional urgency on TASK rows. Null = no priority set. Ignored for other types.
  priority    Priority?

  /// Always stamped when it can be resolved, even for deal and contact
  /// activity, so a company timeline is one indexed range scan rather than
  /// three joins.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ActivityAuthor", fields: [createdById], references: [id])
  /// { from, to } for STAGE_CHANGE; the credit cost for ENRICHMENT; `{ synced:
  /// true }` for anything a Google sync projected.
  meta        Json?

  /// The projection links. Unique because a thread and an event each get exactly
  /// one timeline entry, updated in place as the thread grows or the event moves
  /// — the timeline stays one indexed range scan instead of a three-table union.
  emailThreadId   String?        @unique
  emailThread     EmailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
  @@index([priority])
  @@index([createdById])
  @@map("activity")
}

// ---------------------------------------------------------------------------
// Google sync
//
// Gmail threads and Calendar events get real tables; the timeline gets one
// projected Activity per thread and per event. Identity is deliberately global
// rather than Google's per-mailbox ids — see docs/plan/gmail-calendar-plan.md §4.2.
// ---------------------------------------------------------------------------

enum GoogleSyncStatus {
  IDLE
  RUNNING
  /// The refresh token is gone. Stop trying; the rep has to reconnect.
  NEEDS_RECONNECT
  FAILED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// Per-user, per-source cursor.
///
/// In Postgres because the API is a serverless function with no memory between
/// invocations, and because the in-process EnrichmentQueue deliberately drops
/// queued work on shutdown — fine for enrichment, fatal for a resumable sync.
model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "gmail" | "calendar".
  source String

  status GoogleSyncStatus @default(IDLE)
  /// Gmail: the last processed historyId. Calendar: nextSyncToken.
  ///
  /// Stamped with "now" the first time a mailbox is seen, which is what makes
  /// this forward-only: there is no backfill, so the cursor starts at the
  /// moment of connection and nothing before it is ever read.
  cursor String?
  lastSyncedAt DateTime?
  lastError    String?
  /// Set by the 429/403 handler; the cron skips this row until it passes.
  retryAfter   DateTime?
  /// Auto-creation is opt-in per source — on for calendar, off for Gmail.
  autoCreate   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@map("mailboxSync")
}

/// Per-entity cursor for the Sage CRM pull (see `docs/plans/sage-crm-sync.md`).
///
/// Mirrors `MailboxSync` but keyed by Sage entity, not by user: one Sage
/// service account pulls everything. Postgres for the same reason — the API is
/// serverless and keeps no memory between invocations.
model SageSyncState {
  id     String @id @default(cuid())
  /// "company" | "person" | "opportunity".
  entity String @unique

  status GoogleSyncStatus @default(IDLE)
  /// The high-water `updateddate` seen for this entity; the incremental pull
  /// asks Sage for rows changed after it. Sage caps a query at ~100 rows, so
  /// the pull pages by ascending id within each changed set.
  ///
  /// Kept for back-compat; `highWaterUpdatedAt` is the typed replacement.
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  /// Set by the rate-limit handler; the cron skips this entity until it passes.
  retryAfter   DateTime?

  /// "backfill" until the first full walk finishes, then "incremental".
  phase String @default("backfill")
  /// Last id fetched during the id-paged backfill — the resume checkpoint.
  /// A crash restarts from `<idcol> > backfillId`, so a page is never re-walked.
  backfillId String?
  /// The incremental cursor: rows with `updateddate` after this are re-pulled
  /// (with an overlap). Supersedes the free-text `cursor`.
  highWaterUpdatedAt DateTime?
  /// Rough running count for a progress readout — not load-bearing.
  processed Int?
  /// When the full backfill completed and the entity flipped to incremental.
  backfillDoneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sageSyncState")
}

/// The raw Sage record, kept verbatim so no field is lost before it is mapped.
///
/// Sage exposes far more per entity than the core tables hold. This lossless
/// replica is what the mapping reads from, and what later phases (order
/// history, push-back) can mine without re-querying Sage.
model SageRecordSnapshot {
  id     String @id @default(cuid())
  /// "company" | "person" | "opportunity".
  entity String
  /// The Sage CRM entity id, as a string.
  sageId String
  /// The parsed record exactly as the SOAP query returned it.
  payload   Json
  updatedAt DateTime @updatedAt

  @@unique([entity, sageId])
  @@map("sageRecordSnapshot")
}

/// Outbound push queue: local edits waiting to be written back to Sage CRM.
///
/// The write direction of the Sage sync (plan §5 item 7 / Phase G). A human UI
/// create or update on a Company / Contact / Deal enqueues a row here; a flush
/// under the single Sage session lock (`withSageSession`) drains it, SOAP
/// `add`/`update`s the record, then stamps `sagePushedAt` (+ the new
/// `sageCrm*Id` on a create) so the next pull skips our own write. Mechanical
/// only — no intelligence, mirroring the pull. Deduped in application code
/// (one pending row per record), like `AgentTask`.
model SageOutbox {
  id String @id @default(cuid())

  /// The LOCAL entity: "company" | "contact" | "deal".
  entity String
  /// The local record id (Company / Contact / Deal `id`).
  localId String
  /// "create" (no Sage id yet) | "update" (existing Sage-linked row).
  op String

  /// "pending" | "done" | "failed".
  status String @default("pending")
  /// Push attempts so far; parked as "failed" once it passes the retry cap.
  attempts Int @default(0)
  lastError String?
  /// Set on a transient failure — the flush skips the row until this passes.
  nextAttemptAt DateTime?

  /// The user whose UI action queued this (audit only; may be null).
  requestedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, nextAttemptAt])
  @@index([entity, localId])
  @@map("sageOutbox")
}

/// One conversation, whoever's mailbox it came from.
model EmailThread {
  id String @id @default(cuid())
  /// The RFC 822 Message-ID of the thread root — global, unlike Gmail's
  /// mailbox-scoped threadId. This is what stops two reps on one thread
  /// producing two CRM threads.
  rootMessageId String  @unique
  subject       String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages EmailMessage[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@map("emailThread")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Global message identity. Unique, so account B's sync skips what account A
  /// already ingested.
  rfcMessageId String @unique
  /// Whose mailbox produced this copy, and its id there — for deep links.
  syncedByUserId String?
  gmailMessageId   String?
  /// Outlook/Graph message id for deep links (mirrors gmailMessageId).
  outlookMessageId String?

  direction EmailDirection
  fromEmail String
  fromName  String?
  /// [{ email, name, kind: "to" | "cc" }]. Not a table: nothing queries it.
  recipients Json
  subject    String?
  snippet    String?
  /// Plain text, quoted history stripped. Never logged; never in list payloads.
  body   String?
  sentAt DateTime

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@map("emailMessage")
}

model CalendarEvent {
  id String @id @default(cuid())
  /// Shared by every attendee's copy of the event, and by every instance of a
  /// recurrence — which is why the start time is part of the key.
  iCalUid           String
  originalStartTime DateTime
  /// Set on an instance of a recurring series.
  recurringEventId String?

  title          String?
  description    String?
  location       String?
  conferenceUrl  String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String
  organizerEmail String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  syncedByUserId String?
  googleEventId  String?
  /// Outlook/Graph event id for deep links (mirrors googleEventId).
  outlookEventId String?

  attendees CalendarAttendee[]
  activity  Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iCalUid, originalStartTime])
  @@index([companyId, startsAt])
  @@index([contactId, startsAt])
  @@map("calendarEvent")
}

model CalendarAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email String
  name  String?
  /// needsAction | declined | tentative | accepted
  responseStatus String?
  isOrganizer    Boolean  @default(false)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendarAttendee")
}

/// Domains we never match on and never create from — vendors, ATSs, newsletters.
/// Grows by hand and by a "not a customer" action in the UI.
model SuppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedDomain")
}

/// Targeted Graph import for one address — queued when a contact is added or
/// their email changes. Mechanical only: Nest fetches and matches; the agent
/// never sees these rows.
model EmailBackfill {
  id            String    @id @default(cuid())
  /// Lowercased address. Unique so re-adding the same person reuses the row.
  address       String
  requestedById String?
  /// PENDING | RUNNING | DONE | FAILED
  status        String    @default("PENDING")
  error         String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@unique([address])
  @@index([status, createdAt])
  @@map("emailBackfill")
}

/// External correspondents from unmatched mail — metadata only, never bodies.
///
/// Harvested when Outlook sync drops a thread that does not match a Contact or
/// Company. Approving creates a Contact and enqueues backfill; rejecting can
/// also suppress the whole domain.
model PendingContact {
  id            String    @id @default(cuid())
  /// The rep whose mailbox harvested this candidate — never a shared queue.
  userId        String
  user          User      @relation("PendingContactRep", fields: [userId], references: [id], onDelete: Cascade)
  email         String
  displayName   String?
  domain        String
  /// INBOUND | OUTBOUND — direction of the first sighting.
  direction     String
  sampleSubject String?
  messageCount  Int       @default(1)
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  /// PENDING | APPROVED | REJECTED
  status        String    @default("PENDING")
  decidedById   String?
  decidedAt     DateTime?

  @@unique([userId, email])
  @@index([userId, status, lastSeenAt])
  @@map("pendingContact")
}

/// Website "Customer Question" form leads from the shared info@ mailbox.
///
/// Assigned when territory resolves a rep; `assignedUserId` null = shared claim
/// pool. Distinct from mail `PendingContact` (richer fields + shared routing).
model PendingWebLead {
  id     String @id @default(cuid())
  /// Graph message id or internetMessageId — ingest dedupe.
  sourceMessageId String @unique
  email           String
  displayName     String?
  domain          String
  phone           String?
  companyName     String?
  locationText    String?
  /// Form "Choose a Location to Connect with" when present.
  connectLocation String?
  comments        String?
  sampleSubject   String?
  stateCode       String?
  countryCode     String?
  /// Null = shared pool (first claim wins).
  assignedUserId String?
  assignedUser   User?   @relation("PendingWebLeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  claimedById    String?
  claimedBy      User?   @relation("PendingWebLeadClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt      DateTime?
  receivedAt     DateTime @default(now())
  /// PENDING | APPROVED | REJECTED
  status      String    @default("PENDING")
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, assignedUserId, receivedAt])
  @@index([status, email])
  @@map("pendingWebLead")
}

/// Cursor for the shared webform mailbox poller (singleton row).
model WebformMailboxSync {
  id           String    @id @default("default")
  mailbox      String
  /// ISO receivedDateTime high-water of the last processed message.
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("webformMailboxSync")
}

/// A follow-up the agent noticed in a rep's own synced mail and open deals —
/// never guessed, never written straight to a record. `evidence` cites the
/// real messages behind it; accepting turns it into a real `Activity` TASK.
model FollowUpSuggestion {
  id        String  @id @default(cuid())
  /// The rep this belongs to — the panel is per-rep, never a shared queue.
  userId    String
  contactId String?
  companyId String?
  dealId    String?
  /// commitment | reply-owed | deal-risk | next-step
  kind    String
  /// One sentence, imperative — "Send Acme the revised quote".
  summary String
  /// A short cited excerpt, capped well under a full message. Never a body.
  quote   String? @db.VarChar(300)
  /// When the agent thinks this is due, if the evidence implies one.
  dueHint DateTime?
  /// [{ threadId, messageId, sentAt }] — every suggestion cites real messages.
  evidence Json
  /// PROPOSED | ACCEPTED | DISMISSED | SNOOZED
  status     String  @default("PROPOSED")
  /// The TASK activity created on accept.
  activityId String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([userId, status, createdAt])
  @@map("followUpSuggestion")
}

/// Per-rep Follow-ups page priority settings. Defaults live in code when no
/// row exists — see `packages/db/src/followup-prefs.ts`.
model FollowUpPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// balanced | commitments | replies | deal-risk
  floatFirst String   @default("balanced")
  /// 7d | 30d | 90d
  lookback   String   @default("30d")
  /// owned | shared | mail
  scope      String   @default("owned")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("followUpPreference")
}

// ---------------------------------------------------------------------------
// Email sequences
//
// Mechanical outbound cadences: Nest owns the tick, Graph sends from each
// rep's mailbox, mail sync detects replies. Intelligence stays in the agent.
// ---------------------------------------------------------------------------

enum EmailSequenceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED_REPLIED
  STOPPED_MANUAL
  UNSUBSCRIBED
  BOUNCED
  FAILED
  NEEDS_RECONNECT
}

enum SequenceStepRunStatus {
  SENT
  FAILED
  SKIPPED
}

/// A multi-step email cadence owned by a rep.
model EmailSequence {
  id          String              @id @default(cuid())
  name        String
  description String?
  status      EmailSequenceStatus @default(DRAFT)

  /// IANA timezone for sending-window checks (e.g. "America/Chicago").
  timezone String @default("UTC")
  /// Minutes from midnight (local) when sending may start. Inclusive.
  sendWindowStartMinute Int @default(540)
  /// Minutes from midnight (local) when sending must stop. Exclusive.
  sendWindowEndMinute   Int @default(1020)
  /// JSON array of weekday ints, 0=Sunday … 6=Saturday. Default Mon–Fri.
  sendDays Json @default("[1,2,3,4,5]")

  stopOnReply Boolean @default(true)
  /// When true, inject open/click tracking into sent HTML.
  trackingEnabled Boolean @default(false)

  createdById String
  createdBy   User   @relation("SequenceCreator", fields: [createdById], references: [id], onDelete: Cascade)

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("emailSequence")
}

model SequenceStep {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  /// 0-based position in the sequence.
  order Int
  /// Minutes to wait after the previous step before sending this one.
  /// Step 0 usually has delayMinutes = 0 (send on enroll / next window).
  delayMinutes Int @default(0)

  subject      String
  /// HTML body with merge tokens like {{firstName}}, {{companyName}}.
  bodyTemplate String

  runs SequenceStepRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@map("sequenceStep")
}

model SequenceEnrollment {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Whose Outlook mailbox sends (delegated Graph Mail.Send).
  senderUserId String
  senderUser   User   @relation("SequenceSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy   User   @relation("SequenceEnroller", fields: [enrolledById], references: [id], onDelete: Cascade)

  status           SequenceEnrollmentStatus @default(ACTIVE)
  currentStepOrder Int                      @default(0)
  nextRunAt        DateTime                 @default(now())
  /// Lease for the tick worker (FOR UPDATE SKIP LOCKED pattern).
  leasedUntil      DateTime?
  /// internetMessageId of the first/last sent message for reply threading.
  threadInternetMessageId String?
  stoppedReason           String?

  runs SequenceStepRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
  @@index([contactId])
  @@index([senderUserId])
  @@map("sequenceEnrollment")
}

model SequenceStepRun {
  id           String             @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  status            SequenceStepRunStatus
  sentAt            DateTime?
  internetMessageId String?
  error             String?
  /// Opaque token for open/click/unsubscribe URLs.
  trackingToken     String                @unique @default(cuid())
  openedAt          DateTime?
  clickedAt         DateTime?

  createdAt DateTime @default(now())

  @@index([enrollmentId, createdAt])
  @@index([stepId])
  @@map("sequenceStepRun")
}

/// Global suppression — an unsubscribed address is skipped by every sequence.
model SequenceUnsubscribe {
  id        String   @id @default(cuid())
  /// Lowercased email address.
  email     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([email])
  @@map("sequenceUnsubscribe")
}
